# Development placeholder only. Production must set a unique secret through SOPS/Kubernetes Secret.
DJANGO_SECRET_KEY=unsafe-dev-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_JWT_REFRESH_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SETTINGS_MODULE=student_service.settings.local
DATABASE_URL=sqlite:///db.sqlite3
